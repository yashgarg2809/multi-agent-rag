# --- Supabase only (no Docker). Get from Supabase Dashboard -> Project Settings -> Database ---
# Use the POOLER URL (port 6543) for Vercel/serverless. Enable pgvector first via SQL Editor: create extension if not exists vector;
POSTGRES_CONNECTION_STRING=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
POSTGRES_COLLECTION_NAME=pdf_docs

# Free keys - paste yours here
GROQ_API_KEY=gsk-paste-your-groq-key-here
GOOGLE_API_KEY=AIza-paste-your-gemini-key-here
CEREBRAS_API_KEY=csk-paste-your-cerebras-key-here

# 3 different agents + free embeddings (no local, API only)
ROUTER_MODEL=groq:openai/gpt-oss-20b
RETRIEVER_MODEL=gemini:gemini-3.6-flash
# Used automatically if primary retriever hits quota/dead-model errors (verified working)
RETRIEVER_FALLBACK_MODEL=groq:openai/gpt-oss-120b
CRITIC_MODEL=cerebras:gpt-oss-120b
# Used automatically if primary critic hits quota/dead-model errors (verified working)
CRITIC_FALLBACK_MODEL=groq:openai/gpt-oss-120b
EMBEDDING_MODEL=gemini:models/gemini-embedding-001

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
CRITIC_MAX_RETRIES=1
BACKEND_URL=http://localhost:8000
